{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rimaia",
  "version": "0.1.0",
  "identifier": "com.rimaia.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Rimaia",
        "width": 1280,
        "height": 832,
        "minWidth": 1024,
        "minHeight": 700,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "publisher": "Rimaia",
    "copyright": "Copyright © 2026 Rimaia contributors",
    "shortDescription": "Queue implementation plans, run them unattended with Claude Code.",
    "longDescription": "Rimaia queues implementation plans on a kanban board and runs them unattended with Claude Code, each in its own git worktree, on your own subscription. Kanban board in, reviewable branches out.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
